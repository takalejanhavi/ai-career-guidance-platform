# ──────────────────────────────────────────────────────────────────
# .env.staging — Staging environment
# Deploy to: staging.careerguidance.app
# ──────────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=4000
APP_NAME="Career Guidance API (Staging)"
FRONTEND_URL=https://staging.careerguidance.app
LOG_LEVEL=info

# ── MongoDB Atlas (staging cluster) ───────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@staging-cluster.mongodb.net/career_guidance_staging?retryWrites=true&w=majority

# ── JWT (generate fresh RS256 key pair for each environment) ──────
JWT_PRIVATE_KEY=<REPLACE_WITH_STAGING_PRIVATE_KEY>
JWT_PUBLIC_KEY=<REPLACE_WITH_STAGING_PUBLIC_KEY>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Redis (Upstash staging) ────────────────────────────────────────
REDIS_URL=rediss://:<password>@staging-redis.upstash.io:6379

# ── AI Service ────────────────────────────────────────────────────
AI_SERVICE_URL=https://ai-staging.careerguidance.app
AI_SERVICE_SECRET=<REPLACE_WITH_STAGING_AI_SECRET>

# ── Email (SendGrid / Resend) ─────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<REPLACE_WITH_STAGING_SMTP_KEY>
EMAIL_FROM="CareerAI Staging <noreply@staging.careerguidance.app>"

# ── Storage (S3 or Cloudflare R2 — staging bucket) ────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=career-guidance-staging
S3_REGION=us-east-1
S3_ACCESS_KEY=<REPLACE_WITH_STAGING_S3_KEY>
S3_SECRET_KEY=<REPLACE_WITH_STAGING_S3_SECRET>
S3_SIGNED_URL_EXPIRES=3600

# ── Blockchain (Polygon Mumbai Testnet) ────────────────────────────
BLOCKCHAIN_RPC_URL=https://rpc-mumbai.maticvigil.com
BLOCKCHAIN_PRIVATE_KEY=<REPLACE_WITH_STAGING_WALLET_KEY>
CONTRACT_ADDRESS=<DEPLOYED_STAGING_CONTRACT_ADDRESS>
BLOCKCHAIN_NETWORK=polygon-mumbai

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# ── Frontend ──────────────────────────────────────────────────────
VITE_API_URL=https://api.staging.careerguidance.app
VITE_APP_ENV=staging
