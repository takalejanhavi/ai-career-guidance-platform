# ── Redis (local Docker instance) ─────────────────────────────────
REDIS_URL=redis://redis:6379

# ── AI Service ────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai_service:5050
AI_SERVICE_SECRET=dev_internal_secret_change_in_prod

# ── Email (local MailHog) ──────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
EMAIL_FROM="CareerAI Dev <dev@localhost>"

# ── Storage (local MinIO) ─────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=career-guidance-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SIGNED_URL_EXPIRES=3600

# ── Blockchain ────────────────────────────────────────────────────
BLOCKCHAIN_RPC_URL=http://hardhat_node:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
BLOCKCHAIN_NETWORK=hardhat-local

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100

# ── Frontend (Vite) ───────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_APP_ENV=development
