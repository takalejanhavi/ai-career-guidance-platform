# ──────────────────────────────────────────────────────────────────
# .env.development — Local development environment
# All secrets are safe dummy values for local dev only
# ──────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME="Career Guidance API"
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=debug

# ── MongoDB (local Docker instance) ───────────────────────────────
MONGODB_URI=mongodb://mongo:27017/career_guidance

