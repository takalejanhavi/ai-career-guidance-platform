# ──────────────────────────────────────────────────────────────────
# .env.production — Production environment template
# NEVER commit actual values — use your platform's secret manager
# ──────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000
APP_NAME="Career Guidance API"
FRONTEND_URL=https://careerguidance.app
LOG_LEVEL=info

# ── MongoDB Atlas (M10+ cluster, replica set) ─────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@prod-cluster.mongodb.net/career_guidance?retryWrites=true&w=majority&readPreference=primaryPreferred

# ── JWT RS256 key pair (2048-bit minimum, 4096-bit recommended) ───
JWT_PRIVATE_KEY=<PRODUCTION_RS256_PRIVATE_KEY>
JWT_PUBLIC_KEY=<PRODUCTION_RS256_PUBLIC_KEY>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Redis (Upstash, Render Redis, or Railway Redis) ────────────────
REDIS_URL=rediss://:<password>@prod-redis.upstash.io:6379

# ── AI Service (internal container URL) ───────────────────────────
AI_SERVICE_URL=http://ai_service:5050
AI_SERVICE_SECRET=<PRODUCTION_AI_SECRET_MIN_32_CHARS>

# ── Email (Resend.com recommended for deliverability) ─────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<PRODUCTION_RESEND_API_KEY>
EMAIL_FROM="CareerAI <noreply@careerguidance.app>"

# ── Storage (AWS S3 or Cloudflare R2) ─────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=career-guidance-reports-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=<PRODUCTION_S3_ACCESS_KEY>
S3_SECRET_KEY=<PRODUCTION_S3_SECRET_KEY>
S3_SIGNED_URL_EXPIRES=3600

# ── Blockchain (Polygon Mainnet) ───────────────────────────────────
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_PRIVATE_KEY=<PRODUCTION_WALLET_PRIVATE_KEY>
CONTRACT_ADDRESS=0xb7982dcf0BdDBF66F2815d28aEB3a1138b311996
BLOCKCHAIN_NETWORK=polygon

# ── Rate limiting (tighter in production) ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=<SENTRY_DSN_URL>

# ── Frontend (build-time Vite vars) ───────────────────────────────
VITE_API_URL=https://api.careerguidance.app
VITE_APP_ENV=production
