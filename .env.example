# ═══════════════════════════════════════════════════════════════════
# AI Career Guidance Platform — Consolidated Environment Reference
# ═══════════════════════════════════════════════════════════════════
# This file documents every environment variable used across all
# services. For Docker Compose, copy deployment/envs/.env.development
# to .env at the repo root and edit MONGODB_URI (Atlas) plus any
# blockchain values. For running services individually without
# Docker, each service also has its own .env.example:
#   backend/.env.example
#   frontend/.env.example
#   ai-service/.env.example
#   blockchain/.env.example
# ═══════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME="Career Guidance API"
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ─── MongoDB Atlas ────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/career_guidance?retryWrites=true&w=majority

# ─── JWT (RS256) ──────────────────────────────────────────────────
# Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs1',format:'pem'},publicKeyEncoding:{type:'pkcs1',format:'pem'}});console.log('JWT_PRIVATE_KEY=\"'+privateKey.replace(/\n/g,'\\\\n')+'\"');console.log('JWT_PUBLIC_KEY=\"'+publicKey.replace(/\n/g,'\\\\n')+'\"')"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Redis (Bull queues) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Service ───────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5050
AI_SERVICE_SECRET=change_this_internal_secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
MODEL_VERSION=1.0.0

# ─── Email (SMTP / MailHog in dev) ───────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Career Guidance <noreply@careerguidance.app>"

# ─── Storage (S3 / MinIO) ─────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=career-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_SIGNED_URL_EXPIRES=3600

# ─── Blockchain ───────────────────────────────────────────────────
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_NETWORK=localhost

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Frontend (Vite) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME=MentorChain
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development
