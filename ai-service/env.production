# ── Flask ─────────────────────────────────────────────
FLASK_APP=api/app.py
FLASK_DEBUG=false
PORT=10000

# ── Security ──────────────────────────────────────────
AI_SERVICE_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=https://careerai.vercel.app,https://www.careerai.vercel.app

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── Backend Integration ───────────────────────────────
BACKEND_URL=https://careerai-backend.onrender.com

# ── Database ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://janhavit:database@mernecom.igrid.mongodb.net/career-guidance?retryWrites=true&w=majority

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://default:password@host:port

# ── Model ─────────────────────────────────────────────
MODEL_VERSION=1.0.0
N_TRAIN_SAMPLES=12000

# ── Gunicorn ──────────────────────────────────────────
# WORKERS is hard-coded to 1 in gunicorn.conf.py — this env var is ignored.
# Each extra worker copies the model into its own process (~120 MB each).
# On Render Free (512 MB): 2 workers = 240 MB models + 120 MB runtime = OOM.
WORKERS=1
THREADS=2
TIMEOUT=120

# ── Environment ───────────────────────────────────────
ENVIRONMENT=production