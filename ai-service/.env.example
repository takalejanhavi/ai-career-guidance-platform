# AI Service environment configuration
# Copy to .env and fill in values

# ── Flask ─────────────────────────────────────────────────────────
FLASK_APP=api/app.py
FLASK_DEBUG=false
PORT=5050

# ── Security ──────────────────────────────────────────────────────
# Shared secret between Node.js backend and this service
AI_SERVICE_SECRET=change_me_in_production

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ── Model ─────────────────────────────────────────────────────────
MODEL_VERSION=1.0.0
N_TRAIN_SAMPLES=12000

# ── Workers (gunicorn) ────────────────────────────────────────────
WORKERS=2
THREADS=4
TIMEOUT=120
