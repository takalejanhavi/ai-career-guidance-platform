# ── Network ───────────────────────────────────────────────────────
# Local Hardhat node (default)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Polygon Mumbai testnet
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
# Or via Alchemy/Infura:
# MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_KEY

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# ── Wallet ────────────────────────────────────────────────────────
# Never commit a real private key — use a dedicated deployer wallet
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Deployed contract address (filled after deployment) ──────────
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ── API server ────────────────────────────────────────────────────
PORT=3001
API_SECRET=change_me_in_production

# ── Etherscan / Polygonscan (for contract verification) ───────────
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_KEY

# ── Gas settings ─────────────────────────────────────────────────
GAS_LIMIT=500000
GAS_PRICE_GWEI=50
